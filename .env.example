# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://lexmaris:change-me@localhost:5432/lexmaris?schema=public"

# --- Cache / pub-sub --------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth -------------------------------------------------------------------
# 32+ random bytes, base64. Rotate via a signing-key set, not in place.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
# HMAC key for signature attestations. Losing this invalidates verification of
# every previously executed document -- back it up in the KMS, not in CI.
SIGNATURE_ATTESTATION_KEY=""

# --- Document sealing -------------------------------------------------------
# Production: point at a real KMS and leave LOCAL_MASTER_KEY unset.
KMS_PROVIDER="local"            # local | aws | gcp | vault
KMS_KEY_ID=""
# Dev only: 64 hex chars. createLocalKeyWrapper() throws in production.
LOCAL_MASTER_KEY=""

# --- Object storage ---------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="lexmaris-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
