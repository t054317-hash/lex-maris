# =============================================================================
# LEX MARIS — environment
#
# Copy to .env and fill in. .env is gitignored; never commit a real key.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project: lex-maris (eu-central-1)
NEXT_PUBLIC_SUPABASE_URL="https://yjdtefjlrkfpzofprphf.supabase.co"

# Publishable key. Safe to ship to the browser: every table it can reach is
# gated by Row Level Security, and the secret-bearing tables (document_seals,
# signature_attestations) have RLS on with no policies, so they are unreachable
# with this key by construction.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_mZALtwvoLzpaeNnGVA9rsA_u5rueBgB"

# SERVER ONLY. Bypasses RLS entirely. Never prefix with NEXT_PUBLIC_, never
# import into a client component. Required for the narrow set of writes the
# schema deliberately withholds from the API: risk_reports (the authoritative
# score), audit_events, document_seals, signature_attestations, and payment
# reconciliation from a verified gateway webhook.
# Find it in: Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Payments ----------------------------------------------------------------
# Card checkout. Without this the /api/checkout route returns a clear 501
# rather than pretending to work.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# KNET in Kuwait goes through a local acquirer; Stripe does not carry it.
# Wire one of these for the 'knet' payment method.
TAP_SECRET_KEY=""
MYFATOORAH_API_KEY=""

# --- Document sealing --------------------------------------------------------
# Application-level envelope encryption, layered above Supabase Storage's own
# at-rest encryption. Leave KMS_PROVIDER=local only in development.
KMS_PROVIDER="local"            # local | aws | gcp | vault
KMS_KEY_ID=""
# Dev only: 64 hex chars. createLocalKeyWrapper() throws in production.
LOCAL_MASTER_KEY=""

# HMAC key for signature attestations. Losing this invalidates verification of
# every previously executed document — back it up in the KMS, not in CI.
SIGNATURE_ATTESTATION_KEY=""

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
